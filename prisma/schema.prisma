// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Agreement {
  id                   String   @id @default(cuid())
  shop                 String
  reference            String   @unique
  accessToken          String   @unique
  pinHash              String
  creatorName          String
  creatorEmail         String
  socialHandle         String?
  vehicle              String
  wheelSpecification   String
  deliverables         String
  terms                String
  wheelValuePence      Int
  contributionPence    Int
  salesTarget          Int
  refundEnabled        Boolean  @default(true)
  refundPence          Int
  status               String   @default("AWAITING_CREATOR")
  creatorSignature     String?
  creatorSignedName    String?
  creatorSignedAt      DateTime?
  companySignature     String?
  companySignedName    String?
  companySignedAt      DateTime?
  completedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  changes              AgreementChange[]

  @@index([shop, status])
  @@index([shop, archivedAt])
}

model AgreementChange {
  id          String    @id @default(cuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  changedBy   String?
  changes     Json
  createdAt   DateTime  @default(now())

  @@index([agreementId, createdAt])
}
